# Copy to .env and fill in. Values here match docker-compose.yml defaults.

DATABASE_URL=postgresql+asyncpg://recall:recall_dev_password@localhost:5432/recall

POSTGRES_DB=recall
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Phase 1: local embedding model, no external API key needed.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Retrieval scoring weights (similarity, recency, importance) — must sum to 1.0
SCORE_WEIGHT_SIMILARITY=0.6
SCORE_WEIGHT_RECENCY=0.2
SCORE_WEIGHT_IMPORTANCE=0.2
RECENCY_HALF_LIFE_DAYS=14

# Decay job
DECAY_JOB_INTERVAL_HOURS=24
DEFAULT_TTL_DAYS=

# Uncomment when moving off the local model in a later phase
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=

# Phase 4: connection pool (SQLAlchemy async engine, per worker process)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Phase 4: Redis (search-result cache + rate limiting). Optional at runtime: fails open.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=600   # per user_id, fixed 60s window; 0 disables

# Phase 4: embedding inference
EMBEDDING_DEVICE=cpu        # do NOT use auto/mps with multiple workers (segfaults)
EMBEDDING_MAX_BATCH=32
EMBEDDING_TORCH_THREADS=0   # 0 = torch default; use 1-2 when running several workers
